# OneCheck Backend Environment Configuration
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/onecheck
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
VERIFICATION_SERVICE_URL=http://127.0.0.1:8000
VERIFICATION_TIMEOUT_MS=15000
UPLOAD_DIR=./private_uploads
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_REQUEST=10
ALLOWED_ORIGINS=http://localhost:5173
HMAC_SECRET=replace_with_secret_managed_key_for_deterministic_hash
HMAC_KEY_VERSION=v1
MOCK_VERIFICATION_SERVICE=true
