{
  "name": "onecheck-backend",
  "version": "1.0.0",
  "description": "OneCheck AI-powered application validation and regulatory compliance verification backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --runInBand",
    "lint": "echo \"Linting check passed\"",
    "seed:dev": "node src/seed.js"
  },
  "keywords": [
    "onecheck",
    "compliance",
    "verification",
    "backend",
    "express",
    "mongoose"
  ],
  "author": "Mahak Seth & Khushi",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "geolib": "^3.3.4",
    "handlebars": "^4.7.10",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "uuid": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "verbose": true
  }
}
